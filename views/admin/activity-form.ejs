<% layout("layouts/admin") %>

<div class="min-h-screen bg-gray-100 p-8">

    <div class="max-w-3xl mx-auto">

        <div class="mb-8">

            <a
                href="/admin/activities"
                class="text-sm text-gray-500 hover:text-gray-900"
            >
                ← Back to Activities
            </a>

            <h1 class="text-4xl font-bold text-slate-900 mt-4">
                Add Activity
            </h1>

            <p class="text-gray-500 mt-2">
                Create a new NCC activity and upload its photos.
            </p>

        </div>


        <form
            action="/admin/activities/new"
            method="POST"
            enctype="multipart/form-data"
            class="bg-white rounded-2xl shadow-sm p-6 md:p-8"
        >

            <!-- Title -->

            <div class="mb-6">

                <label
                    for="title"
                    class="block font-semibold mb-2"
                >
                    Activity Title
                </label>

                <input
                    type="text"
                    id="title"
                    name="title"
                    placeholder="Example: CATC-131"
                    required
                    class="w-full px-4 py-3 border border-gray-300
                           rounded-lg focus:outline-none
                           focus:ring-2 focus:ring-green-500"
                >

            </div>


            <!-- Description -->

            <div class="mb-6">

                <label
                    for="description"
                    class="block font-semibold mb-2"
                >
                    Description
                </label>

                <textarea
                    id="description"
                    name="description"
                    rows="5"
                    placeholder="Describe this NCC activity..."
                    class="w-full px-4 py-3 border border-gray-300
                           rounded-lg focus:outline-none
                           focus:ring-2 focus:ring-green-500"
                ></textarea>

            </div>


            <!-- Photos -->

            <div class="mb-8">

                <label
                    for="photos"
                    class="block font-semibold mb-2"
                >
                    Activity Photos
                </label>

                <input
                    type="file"
                    id="photos"
                    name="photos"
                    accept="image/jpeg,image/png,image/webp"
                    multiple
                    required
                    class="w-full px-4 py-3 border border-gray-300
                           rounded-lg bg-white"
                >

                <p class="text-sm text-gray-500 mt-2">
                    You can select multiple photos. Maximum 20 photos.
                </p>

            </div>


            <!-- Submit -->

            <div class="flex gap-4">

                <a
                    href="/admin/activities"
                    class="px-6 py-3 border border-gray-300
                           rounded-lg hover:bg-gray-50"
                >
                    Cancel
                </a>

                <button
                    type="submit"
                    class="px-6 py-3 bg-green-600 text-white
                           rounded-lg font-semibold
                           hover:bg-green-700"
                >
                    Create Activity
                </button>

            </div>

        </form>

    </div>

</div>