<% layout("layouts/boilerplate") %>

<!-- ABOUT PAGE HEADER -->
<section class="relative bg-gray-700 text-white py-10 md:py-18">
  <div class="max-w-7xl mx-auto px-6 text-center">
    <p class="text-sm uppercase tracking-[0.3em] text-green-400 font-semibold">
      Gautam Buddha University
    </p>

    <h1 class="mt-4 text-4xl md:text-6xl font-bold">About NCC</h1>

    <p class="mt-5 max-w-2xl mx-auto text-gray-300 text-base md:text-lg">
      Learn about the aims, values, traditions and spirit of the National Cadet
      Corps.
    </p>
  </div>
</section>

<!-- AIM OF NCC -->
<section class="py-16 md:py-24 bg-white">
  <div class="max-w-5xl mx-auto px-6">
    <!-- Section Heading -->
    <div class="text-center">
      <p
        class="text-sm uppercase tracking-[0.25em] text-green-700 font-semibold"
      >
        Our Purpose
      </p>

      <h2 class="mt-3 text-3xl md:text-4xl font-bold text-gray-900">
        Aim of NCC
      </h2>
    </div>

    <!-- Content -->
    <div
      class="mt-10 bg-gray-50 rounded-2xl p-6 md:p-10 border border-gray-100"
    >
      <p class="text-gray-700 text-base md:text-lg leading-8 text-center">
        The National Cadet Corps aims to develop character, comradeship,
        discipline, leadership, secular outlook, spirit of adventure and ideals
        of selfless service amongst young citizens.
      </p>

      <p class="mt-5 text-gray-700 text-base md:text-lg leading-8 text-center">
        It encourages young people to become responsible, disciplined and
        confident members of society while developing qualities of leadership
        and teamwork.
      </p>
    </div>
  </div>
</section>

<!-- MOTTO OF NCC -->
<section class="py-16 md:py-24 bg-gray-50">
  <div class="max-w-4xl mx-auto px-6 text-center">
    <p class="text-sm uppercase tracking-[0.25em] text-green-700 font-semibold">
      Our Motto
    </p>

    <h2 class="mt-3 text-3xl md:text-4xl font-bold text-gray-900">
      Motto of NCC
    </h2>

    <div class="mt-10">
      <p class="text-4xl md:text-6xl font-bold tracking-wide text-gray-900">
        Unity and Discipline
      </p>

      <div class="w-16 h-1 bg-green-700 mx-auto mt-8"></div>

      <p
        class="mt-8 max-w-2xl mx-auto text-gray-600 text-base md:text-lg leading-relaxed"
      >
        The motto reflects the fundamental spirit of the National Cadet Corps,
        encouraging cadets to work together with discipline, responsibility and
        dedication.
      </p>
    </div>
  </div>
</section>

<!-- CORE VALUES -->
<section class="py-16 md:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-6">
    <!-- Section Heading -->
    <div class="text-center max-w-2xl mx-auto">
      <p
        class="text-sm uppercase tracking-[0.25em] text-green-700 font-semibold"
      >
        What We Stand For
      </p>

      <h2 class="mt-3 text-3xl md:text-4xl font-bold text-gray-900">
        Core Values
      </h2>

      <p class="mt-4 text-gray-600">
        The values that guide NCC cadets in their training, responsibilities and
        everyday life.
      </p>
    </div>

    <!-- Values -->
    <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <!-- Value 1 -->
      <div
        class="p-7 bg-gray-50 rounded-2xl border border-gray-100 hover:shadow-lg transition duration-300"
      >
        <div
          class="w-12 h-12 rounded-xl bg-green-100 flex items-center justify-center"
        >
          <span class="text-green-700 text-xl font-bold"> 01 </span>
        </div>

        <h3 class="mt-6 text-xl font-bold text-gray-900">Discipline</h3>

        <p class="mt-3 text-gray-600 leading-relaxed">
          Developing self-control, responsibility and respect through
          disciplined conduct.
        </p>
      </div>

      <!-- Value 2 -->
      <div
        class="p-7 bg-gray-50 rounded-2xl border border-gray-100 hover:shadow-lg transition duration-300"
      >
        <div
          class="w-12 h-12 rounded-xl bg-green-100 flex items-center justify-center"
        >
          <span class="text-green-700 text-xl font-bold"> 02 </span>
        </div>

        <h3 class="mt-6 text-xl font-bold text-gray-900">Leadership</h3>

        <p class="mt-3 text-gray-600 leading-relaxed">
          Encouraging cadets to take responsibility, make decisions and lead
          with confidence.
        </p>
      </div>

      <!-- Value 3 -->
      <div
        class="p-7 bg-gray-50 rounded-2xl border border-gray-100 hover:shadow-lg transition duration-300"
      >
        <div
          class="w-12 h-12 rounded-xl bg-green-100 flex items-center justify-center"
        >
          <span class="text-green-700 text-xl font-bold"> 03 </span>
        </div>

        <h3 class="mt-6 text-xl font-bold text-gray-900">Teamwork</h3>

        <p class="mt-3 text-gray-600 leading-relaxed">
          Building cooperation, comradeship and mutual respect among cadets.
        </p>
      </div>

      <!-- Value 4 -->
      <div
        class="p-7 bg-gray-50 rounded-2xl border border-gray-100 hover:shadow-lg transition duration-300"
      >
        <div
          class="w-12 h-12 rounded-xl bg-green-100 flex items-center justify-center"
        >
          <span class="text-green-700 text-xl font-bold"> 04 </span>
        </div>

        <h3 class="mt-6 text-xl font-bold text-gray-900">Service</h3>

        <p class="mt-3 text-gray-600 leading-relaxed">
          Inspiring a spirit of selfless service and responsibility towards
          society.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- NCC PLEDGE -->
<section class="py-16 md:py-24 bg-gray-50">
  <div class="max-w-4xl mx-auto px-6">
    <!-- Section Heading -->
    <div class="text-center">
      <p
        class="text-sm uppercase tracking-[0.25em] text-green-700 font-semibold"
      >
        Our Commitment
      </p>

      <h2 class="mt-3 text-3xl md:text-4xl font-bold text-gray-900">
        NCC Pledge
      </h2>
    </div>

    <!-- Pledge Card -->
    <div
      class="mt-10 bg-white rounded-2xl border border-gray-200 shadow-sm p-7 md:p-12"
    >
      <div class="text-center">
        <div
          class="w-14 h-14 mx-auto rounded-full bg-green-100 flex items-center justify-center"
        >
          <span class="text-green-700 text-xl font-bold"> ✦ </span>
        </div>

        <p
          class="mt-8 text-gray-700 text-base md:text-lg leading-8 text-left md:text-center"
        >
            We the cadets of the National Cadet Corps, do solemnly pledge that we shall always uphold the unity of India. We resolve to be disciplined and responsible citizens of our nation. We shall undertake positive community service in the spirit of selflessness and concern for our fellow beings.        </p>
        <div class="mt-8 w-16 h-1 bg-green-700 mx-auto"></div>

        <p class="mt-6 text-sm text-gray-500 uppercase tracking-wider">
          National Cadet Corps
        </p>
      </div>
    </div>
  </div>
</section>

<!-- NCC FLAG -->
<section class="py-16 md:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-6">
    <!-- Section Heading -->
    <div class="text-center max-w-2xl mx-auto">
      <p
        class="text-sm uppercase tracking-[0.25em] text-green-700 font-semibold"
      >
        Symbol of NCC
      </p>

      <h2 class="mt-3 text-3xl md:text-4xl font-bold text-gray-900">
        NCC Flag
      </h2>
    </div>

    <!-- Flag Content -->
    <div
      class="mt-12 grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center"
    >
      <!-- Image -->
      <div class="flex justify-center">
        <div class="w-full max-w-xl overflow-hidden rounded-2xl shadow-lg">
          <img
            src="/images/about/nccFlag.png"
            alt="National Cadet Corps Flag"
            class="w-full h-auto object-cover"
          />
        </div>
      </div>

      <!-- Information -->
      <div>
        <h3 class="text-2xl md:text-3xl font-bold text-gray-900">
          The NCC Flag
        </h3>

        <p class="mt-5 text-gray-600 leading-8">
          The NCC flag represents the identity, traditions and values of the
          National Cadet Corps. It is a symbol of unity, discipline and pride
          for NCC cadets.
        </p>

        <p class="mt-4 text-gray-600 leading-8">
          The colours and emblem of the flag represent the different dimensions
          and ideals associated with the National Cadet Corps.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- NCC SONG -->
<section class="py-16 md:py-24 bg-gray-50">
  <div class="max-w-4xl mx-auto px-6">
    <!-- Section Heading -->
    <div class="text-center">
      <p
        class="text-sm uppercase tracking-[0.25em] text-green-700 font-semibold"
      >
        The Spirit of NCC
      </p>

      <h2 class="mt-3 text-3xl md:text-4xl font-bold text-gray-900">
        NCC Song
      </h2>

      <p class="mt-4 text-gray-600">
        The song that represents the spirit and unity of the National Cadet
        Corps.
      </p>
    </div>

    <!-- Song Card -->
    <div
      class="mt-8 bg-white rounded-2xl border border-gray-200 shadow-sm p-7 md:p-12"
    >
      <div class="text-center">
        <div
          class="w-14 h-14 mx-auto rounded-full bg-green-100 flex items-center justify-center"
        >
          <span class="text-green-700 text-xl"> ♪ </span>
        </div>

        <h3 class="mt-6 text-2xl font-bold text-gray-900">NCC Song</h3>

        <!-- Lyrics -->
        <div
          class="mt-4 text-gray-700 text-base md:text-lg leading-5 text-left md:text-center whitespace-pre-line"
        >
          <p>
            Hum Sab Bharatiya Hain, Hum Sab Bharatiya Hain 
            Apni Manzil Ek Hai,
            Ha, Ha, Ha, Ek Hai,
            Ho, Ho, Ho, Ek Hai.
            Hum Sab Bharatiya Hain.

            Kashmir Ki Dharti Rani Hai,
            Sartaj Himalaya Hai,
            Saadiyon Se Humne Isko Apne Khoon Se Pala Hai 
            Desh Ki Raksha Ki Khatir Hum Shamshir Utha Lenge,
            Hum Shamshir Utha Lenge.
               
            Bikhre Bikhre Taare Hain Hum Lekin Jhilmil Ek Hai, 
            Ha, Ha, Ha, Ek Hai 
            Hum Sab Bharatiya Hai.
            Mandir Gurudwaare Bhi Hain Yahan 
            Aur Masjid Bhi Hai Yahan 
            Girija Ka Hai Ghariyaal Kahin 
            Mullah ki Kahin Hai Ajaan 
            
            Ek Hee Apna Ram Hain, Ek hi Allah Taala Hai, 
            Ek Hee Allah Taala Hain, Raang Birange Deepak Hain Hum, 
            lekin Jagmag Ek Hai, Ha Ha Ha Ek Hai, Ho Ho Ho Ek Hai. 
            Hum Sab Bharatiya Hain, Hum Sab Bharatiya Hain
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
