<% layout("layouts/boilerplate") %>

<section class="py-20 bg-gray-50">

    <div class="max-w-7xl mx-auto px-6">

        <!-- Heading -->

        <div class="text-center mb-12">

            <p class="text-sm uppercase tracking-[0.25em] text-green-600 font-semibold">
                Gautam Buddha University NCC
            </p>

            <h1 class="mt-3 text-4xl md:text-5xl font-bold text-gray-900">
                Activities
            </h1>

            <p class="mt-4 text-gray-600 max-w-2xl mx-auto">
                Explore the activities and training programs conducted
                by our NCC cadets.
            </p>

        </div>


        <!-- Activity Cards -->

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">

            <% activities.forEach(activity => { %>

                <article
                    class="bg-white rounded-2xl overflow-hidden shadow-md
                           hover:shadow-xl transition duration-300"
                >

                    <!-- Cover Image -->

                    <% if (activity.coverImage) { %>

                        <div class="aspect-[4/3] overflow-hidden">

                            <img
                                src="<%= activity.coverImage %>"
                                alt="<%= activity.title %>"
                                class="w-full h-full object-cover
                                       hover:scale-105 transition duration-500"
                            >

                        </div>

                    <% } %>


                    <!-- Card Content -->

                    <div class="p-6">

                        <h2 class="text-2xl font-bold text-gray-900">
                            <%= activity.title %>
                        </h2>

                        <p class="mt-3 text-gray-600 leading-relaxed">
                            <%= activity.description %>
                        </p>


                        <!-- Photo Count -->

                        <p class="mt-4 text-sm text-gray-500">
                            <%= activity.photoCount %> photos
                        </p>


                        <!-- View Photos -->

                        <a
                            href="/activities/<%= activity.slug %>"
                            class="inline-block mt-5 px-5 py-2.5 rounded-lg
                                   bg-gray-900 text-white
                                   hover:bg-gray-700 transition"
                        >
                            View Photos →
                        </a>

                    </div>

                </article>

            <% }) %>

        </div>

    </div>

</section>