<% layout("layouts/boilerplate") %>

<section class="py-16 md:py-24 bg-gray-50">

    <div class="max-w-7xl mx-auto px-6">

        <!-- Heading -->

        <div class="text-center mb-12">

            <p class="text-sm uppercase tracking-[0.25em] text-green-600 font-semibold">
                NCC Activities
            </p>

            <h1 class="mt-3 text-4xl md:text-5xl font-bold text-gray-900">
                <%= activity.title %>
            </h1>

            <p class="mt-4 text-gray-600 max-w-2xl mx-auto">
                <%= activity.description %>
            </p>

        </div>


        <!-- Photos -->

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

            <% photos.forEach(photo => { %>

                <div
                    class="rounded-xl overflow-hidden bg-white shadow-md
                           hover:shadow-xl transition"
                >

                    <img
                        src="<%= photo %>"
                        alt="<%= activity.title %>"
                        loading="lazy"
                        class="w-full aspect-[4/3] object-cover
                               hover:scale-105 transition duration-500"
                    >

                </div>

            <% }) %>

        </div>


        <!-- Back Button -->

        <div class="text-center mt-12">

            <a
                href="/activities"
                class="inline-block px-6 py-3 rounded-lg
                       bg-gray-900 text-white
                       hover:bg-gray-700 transition"
            >
                ← Back to Activities
            </a>

        </div>

    </div>

</section>