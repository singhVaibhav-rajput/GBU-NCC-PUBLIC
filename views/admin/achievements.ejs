<% layout("layouts/admin") %>

<div class="min-h-screen bg-gray-100 p-8">

    <div class="max-w-6xl mx-auto">

        <!-- Header -->

        <div class="flex flex-col md:flex-row
                    md:items-center md:justify-between
                    gap-4 mb-8">

            <div>

                <a
                    href="/admin"
                    class="text-sm text-gray-500
                           hover:text-gray-900"
                >
                    ← Dashboard
                </a>

                <h1 class="text-4xl font-bold
                           text-slate-900 mt-4">
                    Achievements
                </h1>

                <p class="text-gray-500 mt-2">
                    Manage awards and certifications.
                </p>

            </div>


            <a
                href="/admin/achievements/new"
                class="inline-flex items-center
                       justify-center px-5 py-3
                       bg-green-600 text-white
                       rounded-lg font-semibold
                       hover:bg-green-700"
            >
                + Add Achievement
            </a>

        </div>


        <!-- Achievement Cards -->

        <% if (!achievements || achievements.length === 0) { %>

            <div class="bg-white rounded-2xl
                        shadow-sm p-10 text-center">

                <h2 class="text-xl font-semibold
                           text-gray-800">
                    No achievements yet
                </h2>

                <p class="text-gray-500 mt-2">
                    Create your first achievement.
                </p>

            </div>

        <% } else { %>

            <div class="grid grid-cols-1
                        md:grid-cols-2
                        lg:grid-cols-3 gap-6">

                <% achievements.forEach(achievement => { %>

                    <div class="bg-white rounded-2xl
                                shadow-sm overflow-hidden">

                        <!-- Cover -->

                        <% if (achievement.coverImage) { %>

                            <img
                                src="<%= achievement.coverImage %>"
                                alt="<%= achievement.title %>"
                                class="w-full h-52
                                       object-cover"
                            >

                        <% } else { %>

                            <div class="w-full h-52
                                        bg-gray-200
                                        flex items-center
                                        justify-center">

                                <span class="text-gray-400">
                                    No image
                                </span>

                            </div>

                        <% } %>


                        <!-- Content -->

                        <div class="p-5">

                            <h2 class="text-xl font-bold
                                       text-slate-900">
                                <%= achievement.title %>
                            </h2>


                            <p class="text-gray-500
                                      text-sm mt-2">
                                <%= achievement.description || "" %>
                            </p>


                            <div class="mt-4
                                        text-sm text-gray-500">

                                📸
                                <%= achievement.photoCount %>
                                photo<%= achievement.photoCount === 1 ? "" : "s" %>

                            </div>


                            <!-- Buttons -->

                            <div class="flex gap-3 mt-5">

                                <a
                                    href="/admin/achievements/<%= achievement.id %>/edit"
                                    class="flex-1 text-center
                                           px-4 py-2
                                           bg-blue-600
                                           text-white
                                           rounded-lg
                                           hover:bg-blue-700"
                                >
                                    Edit
                                </a>


                                <form
                                    action="/admin/achievements/<%= achievement.id %>/delete"
                                    method="POST"
                                    class="flex-1"
                                    onsubmit="return confirm('Delete this achievement and all its photos?');"
                                >

                                    <button
                                        type="submit"
                                        class="w-full px-4 py-2
                                               bg-red-600
                                               text-white
                                               rounded-lg
                                               hover:bg-red-700"
                                    >
                                        Delete
                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>

                <% }) %>

            </div>

        <% } %>

    </div>

</div>