        <div class="p-4">
          <div class="overflow-hidden rounded-xl bg-gray-100">
            <img
              src="/images/yogiji.png"
              alt="Chancellor of Gautam Buddha University"
              class="block w-full h-64 sm:h-72 object-cover object-top transition-transform duration-500 hover:scale-105"
            />
          </div>
        </div>

        <div class="px-5 pb-6 text-center">
          <p
            class="text-xs uppercase tracking-[0.2em] text-green-600 font-semibold"
          >
            Chancellor
          </p>

          <h3 class="mt-2 text-xl sm:text-2xl font-bold text-slate-900">
            Shri. Yogi Adityanath
          </h3>

          <p class="mt-1 text-sm text-gray-500">Gautam Buddha University</p>
        </div>
      </div>

<!-- VICE CHANCELLOR -->

      <div
        class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-lg"
      >
        <div class="p-4">
          <div class="overflow-hidden rounded-xl bg-gray-100">
            <img
              src="/images/vc.png"
              alt="Vice Chancellor of Gautam Buddha University"
              class="block w-full h-64 sm:h-72 object-cover object-top transition-transform duration-500 hover:scale-105"
            />
          </div>
        </div>

        <div class="px-5 pb-6 text-center">
          <p
            class="text-xs uppercase tracking-[0.2em] text-green-600 font-semibold"
