<% layout("layouts/admin") %>

<div class="min-h-screen bg-gray-100 p-6 md:p-8">

    <div class="max-w-4xl mx-auto">

        <!-- Header -->
        <div class="mb-8">

            <a
                href="/admin/students/<%= student.id %>"
                class="text-sm text-gray-500 hover:text-gray-900 transition"
            >
                ← Back to Student Profile
            </a>

            <h1 class="text-3xl md:text-4xl font-bold text-slate-900 mt-4">
                Edit Student
            </h1>

            <p class="text-gray-500 mt-2">
                Update student and NCC information.
            </p>

        </div>


        <!-- Form -->
        <form
            action="/admin/students/<%= student.id %>?_method=PUT"
            method="POST"
            enctype="multipart/form-data"
            class="bg-white rounded-2xl shadow-sm p-6 md:p-8"
        >

            <!-- PROFILE PICTURE -->

            <div class="mb-10">

                <h2 class="text-xl font-bold text-slate-900 mb-5">
                    Profile Picture
                </h2>

                <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6">

                    <!-- Current Profile Picture -->
                    <div class="shrink-0">

                        <% if (student.profile_image_url) { %>

                            <img
                                id="profilePreview"
                                src="<%= student.profile_image_url %>"
                                alt="<%= student.name %>"
                                class="w-32 h-32 rounded-full object-cover border-4 border-gray-100 shadow-sm"
                            >

                        <% } else { %>

                            <div
                                id="profilePlaceholder"
                                class="w-32 h-32 rounded-full bg-green-100
                                       flex items-center justify-center
                                       border-4 border-gray-100 shadow-sm"
                            >
                                <span class="text-4xl font-bold text-green-700">
                                    <%= student.name
                                        ? student.name.charAt(0).toUpperCase()
                                        : "S" %>
                                </span>
                            </div>

                            <img
                                id="profilePreview"
                                src=""
                                alt="Profile Preview"
                                class="hidden w-32 h-32 rounded-full object-cover border-4 border-gray-100 shadow-sm"
                            >

                        <% } %>

                    </div>


                    <!-- Upload -->
                    <div class="flex-1 w-full">

                        <label
                            for="profile_image"
                            class="block text-sm font-semibold text-gray-700 mb-2"
                        >
                            Change Profile Picture
                        </label>

                        <input
                            type="file"
                            id="profile_image"
                            name="profile_image"
                            accept="image/jpeg,image/png,image/webp"
                            class="w-full px-4 py-3
                                   border border-gray-300
                                   rounded-lg
                                   bg-white
                                   text-gray-700
                                   cursor-pointer
                                   focus:outline-none
                                   focus:ring-2
                                   focus:ring-green-500"
                        >

                        <p class="text-xs text-gray-500 mt-2">
                            JPG, PNG or WebP only. Maximum size: 200 KB.
                        </p>

                        <p
                            id="imageError"
                            class="hidden text-sm text-red-600 mt-2 font-medium"
                        ></p>

                        <p
                            id="imageInfo"
                            class="hidden text-sm text-green-600 mt-2"
                        ></p>

                    </div>

                </div>

            </div>


            <!-- BASIC INFORMATION -->

            <div class="mb-10">

                <h2 class="text-xl font-bold text-slate-900 mb-5">
                    Basic Information
                </h2>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                    <!-- Name -->
                    <div>

                        <label
                            for="name"
                            class="block font-semibold mb-2 text-gray-700"
                        >
                            Full Name
                        </label>

                        <input
                            type="text"
                            id="name"
                            name="name"
                            required
                            value="<%= student.name || '' %>"
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg
                                   focus:outline-none focus:ring-2 focus:ring-green-500"
                        >

                    </div>


                    <!-- Enrollment -->
                    <div>

                        <label
                            for="enrollment_no"
                            class="block font-semibold mb-2 text-gray-700"
                        >
                            NCC Enrollment Number
                        </label>

                        <input
                            type="text"
                            id="enrollment_no"
                            name="enrollment_no"
                            required
                            value="<%= student.enrollment_no || '' %>"
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg
                                   focus:outline-none focus:ring-2 focus:ring-green-500"
                        >

                    </div>


                    <!-- Roll Number -->
                    <div>

                        <label
                            for="roll_no"
                            class="block font-semibold mb-2 text-gray-700"
                        >
                            College Roll Number
                        </label>

                        <input
                            type="text"
                            id="roll_no"
                            name="roll_no"
                            placeholder="e.g. 000ABC000"
                            value="<%= student.roll_no || '' %>"
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg
                                   focus:outline-none focus:ring-2 focus:ring-green-500"
                        >

                    </div>


                    <!-- DOB -->
                    <div>

                        <label
                            for="dob"
                            class="block font-semibold mb-2 text-gray-700"
                        >
                            Date of Birth
                        </label>

                        <input
                            type="date"
                            id="dob"
                            name="dob"
                            value="<%= student.dob || '' %>"
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg
                                   focus:outline-none focus:ring-2 focus:ring-green-500"
                        >

                    </div>


                    <!-- Email -->
                    <div>

                        <label
                            for="email"
                            class="block font-semibold mb-2 text-gray-700"
                        >
                            Email Address
                        </label>

                        <input
                            type="email"
                            id="email"
                            name="email"
                            required
                            value="<%= student.email || '' %>"
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg
                                   focus:outline-none focus:ring-2 focus:ring-green-500"
                        >

                    </div>


                    <!-- Phone -->
                    <div>

                        <label
                            for="phone"
                            class="block font-semibold mb-2 text-gray-700"
                        >
                            Phone Number
                        </label>

                        <input
                            type="tel"
                            id="phone"
                            name="phone"
                            value="<%= student.phone || '' %>"
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg
                                   focus:outline-none focus:ring-2 focus:ring-green-500"
                        >

                    </div>


                    <!-- NCC Batch -->
                    <div>

                        <label
                            for="ncc_batch"
                            class="block font-semibold mb-2 text-gray-700"
                        >
                            NCC Batch
                        </label>

                        <select
                            id="ncc_batch"
                            name="ncc_batch"
                            required
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg
                                   focus:outline-none focus:ring-2 focus:ring-green-500"
                        >

                            <option value="">
                                Select NCC Batch
                            </option>

                            <option
                                value="2025-28"
                                <%= student.ncc_batch === "2025-28" ? "selected" : "" %>
                            >
                                2025-28
                            </option>

                            <option
                                value="2026-29"
                                <%= student.ncc_batch === "2026-29" ? "selected" : "" %>
                            >
                                2026-29
                            </option>

                            <option
                                value="2027-30"
                                <%= student.ncc_batch === "2027-30" ? "selected" : "" %>
                            >
                                2027-30
                            </option>

                        </select>

                    </div>


                    <!-- Active Status -->
                    <div>

                        <label
                            for="is_active"
                            class="block font-semibold mb-2 text-gray-700"
                        >
                            Student Status
                        </label>

                        <select
                            id="is_active"
                            name="is_active"
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg
                                   focus:outline-none focus:ring-2 focus:ring-green-500"
                        >

                            <option
                                value="true"
                                <%= student.is_active ? "selected" : "" %>
                            >
                                Active
                            </option>

                            <option
                                value="false"
                                <%= !student.is_active ? "selected" : "" %>
                            >
                                Inactive
                            </option>

                        </select>

                    </div>

                </div>

            </div>


            <!-- NCC INFORMATION -->

            <div class="mb-10">

                <h2 class="text-xl font-bold text-slate-900 mb-2">
                    NCC Information
                </h2>

                <p class="text-sm text-gray-500 mb-5">
                    Manage the student's NCC entry type and current NCC status.
                </p>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                    <!-- Entry Type -->
                    <div>

                        <label
                            for="ncc_entry_type"
                            class="block font-semibold mb-2 text-gray-700"
                        >
                            NCC Entry Type
                        </label>

                        <select
                            id="ncc_entry_type"
                            name="ncc_entry_type"
                            required
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg
                                   focus:outline-none focus:ring-2 focus:ring-green-500"
                        >

                            <option
                                value="fresh"
                                <%= student.ncc_entry_type === "fresh" ? "selected" : "" %>
                            >
                                Fresh NCC Cadet
                            </option>

                            <option
                                value="b_certificate_holder"
                                <%= student.ncc_entry_type === "b_certificate_holder" ? "selected" : "" %>
                            >
                                B Certificate Holder
                            </option>

                        </select>

                        <p class="text-xs text-gray-500 mt-2">
                            Select B Certificate Holder if the student completed B Certificate before joining GBU.
                        </p>

                    </div>


                    <!-- NCC Status -->
                    <div>

                        <label
                            for="ncc_status"
                            class="block font-semibold mb-2 text-gray-700"
                        >
                            NCC Status
                        </label>

                        <select
                            id="ncc_status"
                            name="ncc_status"
                            required
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg
                                   focus:outline-none focus:ring-2 focus:ring-green-500"
                        >

                            <option
                                value="ongoing"
                                <%= student.ncc_status === "ongoing" ? "selected" : "" %>
                            >
                                Ongoing
                            </option>

                            <option
                                value="completed"
                                <%= student.ncc_status === "completed" ? "selected" : "" %>
                            >
                                Completed
                            </option>

                        </select>

                    </div>

                </div>

            </div>


            <!-- B CERTIFICATE -->

            <div class="mb-10">

                <h2 class="text-xl font-bold text-slate-900 mb-2">
                    B Certificate
                </h2>

                <p class="text-sm text-gray-500 mb-5">
                    Record the student's B Certificate status and details.
                </p>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                    <!-- B Certificate Status -->
                    <div>

                        <label
                            for="b_certificate_status"
                            class="block font-semibold mb-2 text-gray-700"
                        >
                            B Certificate Status
                        </label>

                        <select
                            id="b_certificate_status"
                            name="b_certificate_status"
                            required
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg
                                   focus:outline-none focus:ring-2 focus:ring-green-500"
                        >

                            <option
                                value="not_attempted"
                                <%= student.b_certificate_status === "not_attempted" ? "selected" : "" %>
                            >
                                Not Attempted
                            </option>

                            <option
                                value="ongoing"
                                <%= student.b_certificate_status === "ongoing" ? "selected" : "" %>
                            >
                                Ongoing
                            </option>

                            <option
                                value="passed"
                                <%= student.b_certificate_status === "passed" ? "selected" : "" %>
                            >
                                Passed
                            </option>

                            <option
                                value="failed"
                                <%= student.b_certificate_status === "failed" ? "selected" : "" %>
                            >
                                Failed
                            </option>

                        </select>

                    </div>


                    <!-- B Certificate Number -->
                    <div>

                        <label
                            for="b_certificate_number"
                            class="block font-semibold mb-2 text-gray-700"
                        >
                            B Certificate Number
                        </label>

                        <input
                            type="text"
                            id="b_certificate_number"
                            name="b_certificate_number"
                            value="<%= student.b_certificate_number || '' %>"
                            placeholder="Enter certificate number"
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg
                                   focus:outline-none focus:ring-2 focus:ring-green-500"
                        >

                    </div>


                    <!-- B Certificate Year -->
                    <div>

                        <label
                            for="b_certificate_year"
                            class="block font-semibold mb-2 text-gray-700"
                        >
                            B Certificate Year
                        </label>

                        <input
                            type="number"
                            id="b_certificate_year"
                            name="b_certificate_year"
                            value="<%= student.b_certificate_year || '' %>"
                            placeholder="e.g. 2025"
                            min="2000"
                            max="2100"
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg
                                   focus:outline-none focus:ring-2 focus:ring-green-500"
                        >

                    </div>


                    <!-- B Certificate Grade -->
                    <div>

                        <label
                            for="b_certificate_grade"
                            class="block font-semibold mb-2 text-gray-700"
                        >
                            B Certificate Grade
                        </label>

                        <select
                            id="b_certificate_grade"
                            name="b_certificate_grade"
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg
                                   focus:outline-none focus:ring-2 focus:ring-green-500"
                        >

                            <option value="">
                                Select Grade
                            </option>

                            <option
                                value="A"
                                <%= student.b_certificate_grade === "A" ? "selected" : "" %>
                            >
                                A
                            </option>

                            <option
                                value="B"
                                <%= student.b_certificate_grade === "B" ? "selected" : "" %>
                            >
                                B
                            </option>

                            <option
                                value="C"
                                <%= student.b_certificate_grade === "C" ? "selected" : "" %>
                            >
                                C
                            </option>

                        </select>

                    </div>

                </div>

            </div>


            <!-- C CERTIFICATE -->

            <div class="mb-10">

                <h2 class="text-xl font-bold text-slate-900 mb-2">
                    C Certificate
                </h2>

                <p class="text-sm text-gray-500 mb-5">
                    Record the student's C Certificate status and details.
                </p>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                    <!-- C Certificate Status -->
                    <div>

                        <label
                            for="c_certificate_status"
                            class="block font-semibold mb-2 text-gray-700"
                        >
                            C Certificate Status
                        </label>

                        <select
                            id="c_certificate_status"
                            name="c_certificate_status"
                            required
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg
                                   focus:outline-none focus:ring-2 focus:ring-green-500"
                        >

                            <option
                                value="not_eligible"
                                <%= student.c_certificate_status === "not_eligible" ? "selected" : "" %>
                            >
                                Not Eligible
                            </option>

                            <option
                                value="eligible"
                                <%= student.c_certificate_status === "eligible" ? "selected" : "" %>
                            >
                                Eligible
                            </option>

                            <option
                                value="ongoing"
                                <%= student.c_certificate_status === "ongoing" ? "selected" : "" %>
                            >
                                Ongoing
                            </option>

                            <option
                                value="passed"
                                <%= student.c_certificate_status === "passed" ? "selected" : "" %>
                            >
                                Passed
                            </option>

                            <option
                                value="failed"
                                <%= student.c_certificate_status === "failed" ? "selected" : "" %>
                            >
                                Failed
                            </option>

                        </select>

                    </div>


                    <!-- C Certificate Number -->
                    <div>

                        <label
                            for="c_certificate_number"
                            class="block font-semibold mb-2 text-gray-700"
                        >
                            C Certificate Number
                        </label>

                        <input
                            type="text"
                            id="c_certificate_number"
                            name="c_certificate_number"
                            value="<%= student.c_certificate_number || '' %>"
                            placeholder="Enter certificate number"
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg
                                   focus:outline-none focus:ring-2 focus:ring-green-500"
                        >

                    </div>


                    <!-- C Certificate Year -->
                    <div>

                        <label
                            for="c_certificate_year"
                            class="block font-semibold mb-2 text-gray-700"
                        >
                            C Certificate Year
                        </label>

                        <input
                            type="number"
                            id="c_certificate_year"
                            name="c_certificate_year"
                            value="<%= student.c_certificate_year || '' %>"
                            placeholder="e.g. 2026"
                            min="2000"
                            max="2100"
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg
                                   focus:outline-none focus:ring-2 focus:ring-green-500"
                        >

                    </div>


                    <!-- C Certificate Grade -->
                    <div>

                        <label
                            for="c_certificate_grade"
                            class="block font-semibold mb-2 text-gray-700"
                        >
                            C Certificate Grade
                        </label>

                        <select
                            id="c_certificate_grade"
                            name="c_certificate_grade"
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg
                                   focus:outline-none focus:ring-2 focus:ring-green-500"
                        >

                            <option value="">
                                Select Grade
                            </option>

                            <option
                                value="A"
                                <%= student.c_certificate_grade === "A" ? "selected" : "" %>
                            >
                                A
                            </option>

                            <option
                                value="B"
                                <%= student.c_certificate_grade === "B" ? "selected" : "" %>
                            >
                                B
                            </option>

                            <option
                                value="C"
                                <%= student.c_certificate_grade === "C" ? "selected" : "" %>
                            >
                                C
                            </option>

                        </select>

                    </div>

                </div>

            </div>


            <!-- PARENT INFORMATION -->

            <div class="mb-10">

                <h2 class="text-xl font-bold text-slate-900 mb-5">
                    Parent Information
                </h2>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                    <!-- Father Name -->
                    <div>

                        <label
                            for="father_name"
                            class="block font-semibold mb-2 text-gray-700"
                        >
                            Father's Name
                        </label>

                        <input
                            type="text"
                            id="father_name"
                            name="father_name"
                            value="<%= student.father_name || '' %>"
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg
                                   focus:outline-none focus:ring-2 focus:ring-green-500"
                        >

                    </div>


                    <!-- Father Phone -->
                    <div>

                        <label
                            for="father_phone"
                            class="block font-semibold mb-2 text-gray-700"
                        >
                            Father's Phone
                        </label>

                        <input
                            type="tel"
                            id="father_phone"
                            name="father_phone"
                            value="<%= student.father_phone || '' %>"
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg
                                   focus:outline-none focus:ring-2 focus:ring-green-500"
                        >

                    </div>

                </div>

            </div>


            <!-- BANK INFORMATION -->
            
            <div class="mb-10">

                <h2 class="text-xl font-bold text-slate-900 mb-2">
                    Bank Information
                </h2>

                <p class="text-sm text-gray-500 mb-5">
                    This information is private and available only
                    to authorized NCC administrators.
                </p>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                    <!-- Account -->
                    <div>

                        <label
                            for="bank_account_no"
                            class="block font-semibold mb-2 text-gray-700"
                        >
                            Bank Account Number
                        </label>

                        <input
                            type="text"
                            id="bank_account_no"
                            name="bank_account_no"
                            value="<%= student.bank_account_no || '' %>"
                            autocomplete="off"
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg
                                   focus:outline-none focus:ring-2 focus:ring-green-500"
                        >

                    </div>


                    <!-- IFSC -->
                    <div>

                        <label
                            for="ifsc_code"
                            class="block font-semibold mb-2 text-gray-700"
                        >
                            IFSC Code
                        </label>

                        <input
                            type="text"
                            id="ifsc_code"
                            name="ifsc_code"
                            value="<%= student.ifsc_code || '' %>"
                            autocomplete="off"
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg
                                   uppercase
                                   focus:outline-none focus:ring-2 focus:ring-green-500"
                        >

                    </div>

                </div>

            </div>


            <!-- BUTTONS -->

            <div class="flex flex-col sm:flex-row gap-3">

                <a
                    href="/admin/students/<%= student.id %>"
                    class="px-6 py-3 border border-gray-300 rounded-lg
                           text-center hover:bg-gray-50 transition"
                >
                    Cancel
                </a>

                <button
                    id="saveButton"
                    type="submit"
                    class="px-6 py-3 bg-green-600 text-white rounded-lg
                           font-semibold hover:bg-green-700 transition"
                >
                    Save Changes
                </button>

            </div>

        </form>

    </div>

</div>

<!-- PROFILE IMAGE PREVIEW + VALIDATION -->
<script>

const profileInput = document.getElementById("profile_image");
const profilePreview = document.getElementById("profilePreview");
const profilePlaceholder = document.getElementById("profilePlaceholder");
const imageError = document.getElementById("imageError");
const imageInfo = document.getElementById("imageInfo");
const saveButton = document.getElementById("saveButton");

const MAX_FILE_SIZE = 200 * 1024;

profileInput.addEventListener("change", function () {

    imageError.classList.add("hidden");
    imageInfo.classList.add("hidden");

    const file = this.files[0];

    if (!file) {
        return;
    }

    const allowedTypes = [
        "image/jpeg",
        "image/png",
        "image/webp"
    ];

    // File type validation
    if (!allowedTypes.includes(file.type)) {

        imageError.textContent =
            "Only JPG, PNG and WebP images are allowed.";

        imageError.classList.remove("hidden");

        this.value = "";

        return;
    }


    // File size validation
    if (file.size > MAX_FILE_SIZE) {

        imageError.textContent =
            "Profile picture must be 200 KB or less.";

        imageError.classList.remove("hidden");

        this.value = "";

        return;
    }


    // Show file information
    const sizeKB = (file.size / 1024).toFixed(1);

    imageInfo.textContent =
        `${file.name} • ${sizeKB} KB`;

    imageInfo.classList.remove("hidden");


    // Preview image
    const reader = new FileReader();

    reader.onload = function (event) {

        profilePreview.src = event.target.result;

        profilePreview.classList.remove("hidden");

        if (profilePlaceholder) {
            profilePlaceholder.classList.add("hidden");
        }

    };

    reader.readAsDataURL(file);

});

</script>