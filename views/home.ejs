            Vice Chancellor
          </p>

          <h3 class="mt-2 text-xl sm:text-2xl font-bold text-slate-900">
            Prof. Rana Pratap Singh
          </h3>

          <p class="mt-1 text-sm text-gray-500">Gautam Buddha University</p>
        </div>
      </div>
    </div>

<!-- DIVIDER -->

    <div class="flex items-center justify-center my-10 sm:my-12">
      <div class="h-px w-16 sm:w-24 bg-green-200"></div>

      <div class="mx-3 w-2 h-2 rounded-full bg-green-600"></div>

      <div class="h-px w-16 sm:w-24 bg-green-200"></div>
    </div>

<!-- NCC COORDINATION -->

    <div class="text-center mb-6">
      <h3 class="text-lg sm:text-xl font-bold text-slate-800">
        NCC Coordination
      </h3>

      <div class="mx-auto mt-2 w-10 h-1 bg-green-600 rounded-full"></div>
    </div>

<!-- NCC COORDINATOR -->

    <div class="max-w-4xl mx-auto">
      <div
        class="bg-white rounded-2xl sm:rounded-3xl border border-green-100 shadow-md overflow-hidden"
      >
        <div class="flex flex-col md:flex-row">

<!-- COORDINATOR IMAGE -->

          <div class="w-full md:w-2/5 p-5 sm:p-6 flex justify-center">
            <div
              class="w-full max-w-sm overflow-hidden rounded-xl  shadow-sm"
            >
              <img
                src="/images/ano.png"
                alt="NCC Caretaker and Coordinator"
                class="block w-full h-80 sm:h-96 md:h-[330px] object-cover object-top transition-transform duration-500 hover:scale-105"
              />
            </div>
          </div>

 <!-- COORDINATOR INFORMATION -->

          <div class="w-full md:w-3/5 p-6 sm:p-8 lg:p-10 flex items-center">
