<% layout("layouts/admin") %>

<section class="p-6 md:p-10">

    <div class="max-w-7xl mx-auto">

        <div class="mb-10">

            <p class="text-sm uppercase tracking-[0.25em]
                      text-green-600 font-semibold">
                NCC Administration
            </p>

            <h1 class="text-4xl font-bold mt-2">
                Dashboard
            </h1>

            <p class="text-gray-500 mt-2">
                Manage your NCC website content.
            </p>

        </div>


        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">


            <!-- Notices -->

            <a
                href="/admin/notices"
                class="bg-white rounded-2xl p-6 shadow-sm
                       hover:shadow-md transition"
            >

                <div class="text-3xl mb-4">
                    📢
                </div>

                <h2 class="text-xl font-bold">
                    Notices
                </h2>

                <p class="text-gray-500 mt-2">
                    Create, edit and delete notices.
                </p>

            </a>


            <!-- Activities -->

            <a
                href="/admin/activities"
                class="bg-white rounded-2xl p-6 shadow-sm
                       hover:shadow-md transition"
            >

                <div class="text-3xl mb-4">
                    🏕️
                </div>

                <h2 class="text-xl font-bold">
                    Activities
                </h2>

                <p class="text-gray-500 mt-2">
                    Manage NCC activities and photos.
                </p>

            </a>


            <!-- Achievements -->

            <a
                href="/admin/achievements"
                class="bg-white rounded-2xl p-6 shadow-sm
                       hover:shadow-md transition"
            >

                <div class="text-3xl mb-4">
                    🏆
                </div>

                <h2 class="text-xl font-bold">
                    Achievements
                </h2>

                <p class="text-gray-500 mt-2">
                    Manage awards and certifications.
                </p>

            </a>

        </div>

    </div>

</section>