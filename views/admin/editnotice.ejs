<% layout("layouts/admin") %>

<section class="py-16 md:py-24 bg-gray-50">

    <div class="max-w-3xl mx-auto px-6">

        <div class="mb-10">

            <p class="text-sm uppercase tracking-[0.25em]
                      text-green-600 font-semibold">
                Admin Panel
            </p>

            <h1 class="mt-3 text-4xl font-bold text-gray-900">
                Edit Notice
            </h1>

        </div>


        <div class="bg-white rounded-2xl shadow-sm p-6 md:p-8">

            <form
                action="/admin/notices/<%= notice.id %>/edit"
                method="POST"
                enctype="multipart/form-data"
                class="space-y-6"
            >

                <!-- Title -->

                <div>

                    <label
                        for="title"
                        class="block mb-2 font-medium text-gray-700"
                    >
                        Notice Title
                    </label>

                    <input
                        type="text"
                        id="title"
                        name="title"
                        value="<%= notice.title %>"
                        required
                        class="w-full px-4 py-3 border border-gray-300
                               rounded-lg focus:outline-none
                               focus:ring-2 focus:ring-green-500"
                    >

                </div>


                <!-- Date -->

                <div>

                    <label
                        for="date"
                        class="block mb-2 font-medium text-gray-700"
                    >
                        Notice Date
                    </label>

                    <input
                        type="date"
                        id="date"
                        name="date"
                        value="<%= notice.date %>"
                        required
                        class="w-full px-4 py-3 border border-gray-300
                               rounded-lg focus:outline-none
                               focus:ring-2 focus:ring-green-500"
                    >

                </div>


                <!-- Current file -->

                <div>

                    <p class="font-medium text-gray-700 mb-2">
                        Current PDF
                    </p>

                    <p class="text-sm text-gray-500 break-all">
                        <%= notice.file_path %>
                    </p>

                </div>


                <!-- New PDF -->

                <div>

                    <label
                        for="noticeFile"
                        class="block mb-2 font-medium text-gray-700"
                    >
                        Replace PDF
                    </label>

                    <input
                        type="file"
                        id="noticeFile"
                        name="noticeFile"
                        accept="application/pdf"
                        class="w-full px-4 py-3 border border-gray-300
                               rounded-lg"
                    >

                    <p class="mt-2 text-sm text-gray-500">
                        Leave empty if you don't want to replace the PDF.
                    </p>

                </div>


                <div class="flex gap-3">

                    <button
                        type="submit"
                        class="px-6 py-3 rounded-lg
                               bg-gray-900 text-white
                               hover:bg-gray-700 transition"
                    >
                        Save Changes
                    </button>

                    <a
                        href="/admin/notices"
                        class="px-6 py-3 rounded-lg
                               border border-gray-300
                               hover:bg-gray-100 transition"
                    >
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</section>