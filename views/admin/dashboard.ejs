<% layout("layouts/admin") %>

<section class="p-6 md:p-10">

    <div class="max-w-7xl mx-auto">

        <!-- HEADER -->
        <div class="mb-10">

            <p class="text-sm uppercase tracking-[0.25em] text-green-600 font-semibold">
                NCC Administration
            </p>

            <h1 class="text-4xl font-bold mt-2 text-slate-900">
                Dashboard
            </h1>

            <p class="text-gray-500 mt-2">
                Manage your NCC website and student information.
            </p>

        </div>



        <!-- VACANCY MANAGEMENT -->

<div class="mb-10">

    <h2 class="text-xl font-bold text-slate-900 mb-5">
        Vacancy Management
    </h2>

    <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">

        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">

            <div>

                <p class="text-sm text-gray-500">
                    Current NCC Vacancies
                </p>

                <p class="text-4xl font-bold text-slate-900 mt-2">
                    <%= stats.vacancies %>
                </p>

                <p class="text-sm text-gray-400 mt-2">
                    Update this value manually whenever the NCC vacancy changes.
                </p>

            </div>


            <form
                action="/admin/vacancies"
                method="POST"
                class="flex flex-col sm:flex-row gap-3"
            >

                <input
                    type="number"
                    name="vacancies"
                    min="0"
                    step="1"
                    value="<%= stats.vacancies %>"
                    required
                    class="w-full sm:w-40 px-4 py-3 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-green-500"
                >

                <button
                    type="submit"
                    class="px-6 py-3 bg-green-600 text-white rounded-lg font-semibold hover:bg-green-700 transition"
                >
                    Update Vacancies
                </button>

            </form>

        </div>

    </div>

</div>


        <!-- STUDENT STATISTICS -->

        <div class="mb-10">

            <h2 class="text-xl font-bold text-slate-900 mb-5">
                NCC Statistics
            </h2>


            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-5">


                <!-- TOTAL STUDENTS -->

                <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">

                    <p class="text-sm text-gray-500">
                        Total Students
                    </p>

                    <p class="text-4xl font-bold text-slate-900 mt-3">
                        <%= stats.totalStudents %>
                    </p>

                </div>


                <!-- VACANCIES -->

                <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">

                    <p class="text-sm text-gray-500">
                        Vacancies
                    </p>

                    <p class="text-4xl font-bold text-slate-900 mt-3">
                        <%= stats.vacancies %>
                    </p>

                </div>


                <!-- NCC COMPLETED -->

                <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">

                    <p class="text-sm text-gray-500">
                        NCC Completed
                    </p>

                    <p class="text-4xl font-bold text-slate-900 mt-3">
                        <%= stats.nccCompleted %>
                    </p>

                </div>


                <!-- NCC ONGOING -->

                <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">

                    <p class="text-sm text-gray-500">
                        NCC Ongoing
                    </p>

                    <p class="text-4xl font-bold text-slate-900 mt-3">
                        <%= stats.nccOngoing %>
                    </p>

                </div>


                <!-- C CERTIFICATE ONGOING -->

                <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">

                    <p class="text-sm text-gray-500">
                        C Certificate Ongoing
                    </p>

                    <p class="text-4xl font-bold text-slate-900 mt-3">
                        <%= stats.cCertificateOngoing %>
                    </p>

                </div>


            </div>

        </div>



        <!-- ADMIN MANAGEMENT -->

        <div>

            <h2 class="text-xl font-bold text-slate-900 mb-5">
                Management
            </h2>


            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">


                <!-- NOTICES -->

                <a
                    href="/admin/notices"
                    class="bg-white rounded-2xl p-6 shadow-sm hover:shadow-md transition border border-gray-100"
                >

                    <div class="text-3xl mb-4">
                        📢
                    </div>

                    <h2 class="text-xl font-bold text-slate-900">
                        Notices
                    </h2>

                    <p class="text-gray-500 mt-2">
                        Create, edit and delete notices.
                    </p>

                </a>



                <!-- ACTIVITIES -->

                <a
                    href="/admin/activities"
                    class="bg-white rounded-2xl p-6 shadow-sm hover:shadow-md transition border border-gray-100"
                >

                    <div class="text-3xl mb-4">
                        🏕️
                    </div>

                    <h2 class="text-xl font-bold text-slate-900">
                        Activities
                    </h2>

                    <p class="text-gray-500 mt-2">
                        Manage NCC activities and photos.
                    </p>

                </a>



                <!-- ACHIEVEMENTS -->

                <a
                    href="/admin/achievements"
                    class="bg-white rounded-2xl p-6 shadow-sm hover:shadow-md transition border border-gray-100"
                >

                    <div class="text-3xl mb-4">
                        🏆
                    </div>

                    <h2 class="text-xl font-bold text-slate-900">
                        Achievements
                    </h2>

                    <p class="text-gray-500 mt-2">
                        Manage awards and certifications.
                    </p>

                </a>



                <!-- STUDENTS -->

                <a
                    href="/admin/students"
                    class="bg-white rounded-2xl p-6 shadow-sm hover:shadow-md transition border border-gray-100"
                >

                    <div class="text-3xl mb-4">
                        👨‍🎓
                    </div>

                    <h2 class="text-xl font-bold text-slate-900">
                        Students
                    </h2>

                    <p class="text-gray-500 mt-2">
                        Manage NCC students and profiles.
                    </p>

                </a>


            </div>

        </div>

    </div>

</section>