<% layout("layouts/boilerplate") %>

<section class="py-16 md:py-24 bg-gray-50">

    <div class="max-w-5xl mx-auto px-6">

        <div class="text-center mb-12">

            <p class="text-sm uppercase tracking-[0.25em] text-green-600 font-semibold">
                NCC Notices
            </p>

            <h1 class="mt-3 text-4xl md:text-5xl font-bold text-gray-900">
                Notices
            </h1>

        </div>


        <div class="space-y-5">

            <% notices.forEach(notice => { %>

                <div class="bg-white rounded-xl shadow-sm p-6
                            flex flex-col md:flex-row
                            md:items-center md:justify-between gap-4">

                    <div>

                        <h2 class="text-xl font-semibold text-gray-900">
                            <%= notice.title %>
                        </h2>

                        <p class="mt-2 text-gray-500">
                            Date:
                            <%= new Date(notice.date).toLocaleDateString("en-IN", {
                                day: "2-digit",
                                month: "long",
                                year: "numeric"
                            }) %>
                        </p>

                    </div>

                    <a href="<%= notice.fileUrl %>" target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 rounded-lg bg-gray-900 text-white hover:bg-gray-700 transition inline-block">
                        View / Download
                    </a>

                </div>

            <% }) %>

        </div>

    </div>

</section>