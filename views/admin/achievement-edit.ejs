<% layout("layouts/admin") %>

<div class="min-h-screen bg-gray-100 p-8">

    <div class="max-w-5xl mx-auto">

        <!-- Header -->

        <div class="mb-8">

            <a
                href="/admin/achievementss"
                class="text-sm text-gray-500 hover:text-gray-900"
            >
                ← Back to Achievements
            </a>

            <h1 class="text-4xl font-bold text-slate-900 mt-4">
                Edit Achievements
            </h1>

            <p class="text-gray-500 mt-2">
                Update achievevements details, add photos, or delete existing photos.
            </p>

        </div>

        <!-- EXISTING PHOTOS -->

        <div class="bg-white rounded-2xl shadow-sm p-6 md:p-8 mb-8">

            <h2 class="text-xl font-bold text-slate-900 mb-5">
                Existing Photos
            </h2>


            <% if (!photos || photos.length === 0) { %>

                <p class="text-gray-500">
                    No photos uploaded.
                </p>

            <% } else { %>

                <div class="grid grid-cols-2 md:grid-cols-4 gap-5">

                    <% photos.forEach(photo => { %>

                        <div class="bg-gray-100 rounded-xl overflow-hidden">

                            <!-- Photo -->

                            <img
                                src="<%= photo.url %>"
                                alt="Achievements photo"
                                class="w-full h-40 object-cover"
                            >


                            <div class="p-3">

                                <!-- File name -->

                                <p class="text-xs text-gray-500 truncate mb-3">
                                    <%= photo.name %>
                                </p>


                                <!-- Delete Photo Form -->

                                <form
                                    action="/admin/achievements/<%= achievement.id %>/photo/delete"
                                    method="POST"
                                    onsubmit="return confirm('Are you sure you want to delete this photo?');"
                                >

                                    <input
                                        type="hidden"
                                        name="fileName"
                                        value="<%= photo.name %>"
                                    >

                                    <button
                                        type="submit"
                                        class="w-full px-3 py-2
                                               bg-red-600 text-white
                                               rounded-lg text-sm
                                               font-medium
                                               hover:bg-red-700"
                                    >
                                        Delete Photo
                                    </button>

                                </form>

                            </div>

                        </div>

                    <% }) %>

                </div>

            <% } %>

        </div>

        <!-- EDIT ACHIEVEMENTS FORM -->

        <form
            action="/admin/achievements/<%= achievement.id %>/edit"
            method="POST"
            enctype="multipart/form-data"
            class="bg-white rounded-2xl shadow-sm p-6 md:p-8"
        >

            <!-- Title -->

            <div class="mb-6">

                <label
                    for="title"
                    class="block font-semibold mb-2"
                >
                    Activity Title
                </label>

                <input
                    type="text"
                    id="title"
                    name="title"
                    value="<%= achievement.title %>"
                    required
                    class="w-full px-4 py-3 border border-gray-300
                           rounded-lg focus:outline-none
                           focus:ring-2 focus:ring-green-500"
                >

            </div>

            <!-- Description -->
            <div class="mb-8">
                <label
                    for="description"
                    class="block font-semibold mb-2"
                >
                    Description
                </label>

                <textarea
                    id="description"
                    name="description"
                    rows="5"
                    class="w-full px-4 py-3 border border-gray-300
                           rounded-lg focus:outline-none
                           focus:ring-2 focus:ring-green-500"
                ><%= achievement.description || "" %></textarea>

            </div>

            <!-- Add Photos -->

            <div class="mb-8">

                <label
                    for="photos"
                    class="block font-semibold mb-2"
                >
                    Add More Photos
                </label>

                <input
                    type="file"
                    id="photos"
                    name="photos"
                    accept="image/jpeg,image/png,image/webp"
                    multiple
                    class="w-full px-4 py-3 border border-gray-300
                           rounded-lg bg-white"
                >

                <p class="text-sm text-gray-500 mt-2">
                    Select multiple photos if you want to add more.
                </p>

            </div>


            <!-- Buttons -->

            <div class="flex gap-4">

                <a
                    href="/admin/achievements"
                    class="px-6 py-3 border border-gray-300
                           rounded-lg hover:bg-gray-50"
                >
                    Cancel
                </a>

                <button
                    type="submit"
                    class="px-6 py-3 bg-green-600 text-white
                           rounded-lg font-semibold
                           hover:bg-green-700"
                >
                    Save Changes
                </button>

            </div>

        </form>

    </div>

</div>